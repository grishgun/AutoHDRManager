<Window x:Class="AutoHDRManager.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AutoHDRManager.App" Title="Auto HDR Manager">
<Grid x:Name="Root">
 <Grid.Resources><ResourceDictionary>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light">
    <LinearGradientBrush x:Key="PlaceholderSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DDE5EF"/><GradientStop Color="#F3F5F9" Offset="0.5"/><GradientStop Color="#CBD6E5" Offset="1"/></LinearGradientBrush>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Dark">
    <LinearGradientBrush x:Key="PlaceholderSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#28384C"/><GradientStop Color="#1A2534" Offset="0.55"/><GradientStop Color="#343244" Offset="1"/></LinearGradientBrush>
   </ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="PlaceholderSurface" Color="{ThemeResource SystemColorWindowColor}"/></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <local:LocalizedStrings x:Key="Strings"/><local:BoolVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="SectionCard" TargetType="Border"><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/></Style>
  <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource SectionCard}"><Setter Property="Padding" Value="18,14"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="DescriptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="QuietIconButton" TargetType="Button"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <DataTemplate x:Key="ProcessTemplate"><Grid Padding="4,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="32" Height="32"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PathLabel}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PathLabel}"/></StackPanel></Grid></DataTemplate>
  <DataTemplate x:Key="GameCard">
   <Grid Width="{Binding CardWidth}">
    <Border x:Name="CardSurface" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
     <StackPanel>
      <Grid Height="{Binding CoverHeight}">
       <Border CornerRadius="11,11,0,0" Background="{ThemeResource PlaceholderSurface}" Visibility="{Binding HasPlaceholder, Converter={StaticResource BoolVisibility}}">
        <Grid Padding="16">
         <StackPanel VerticalAlignment="Center" Spacing="16">
          <Border Width="80" Height="80" CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
           <Grid><Image Source="{Binding CoverImage}" Width="56" Height="56" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding [GameIcon], Source={StaticResource Strings}}"/><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="32" Visibility="{Binding NeedsGlyph, Converter={StaticResource BoolVisibility}}"/></Grid>
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
         </StackPanel>
        </Grid>
       </Border>
       <Border CornerRadius="11,11,0,0" Visibility="{Binding HasArtwork, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding [GameCover], Source={StaticResource Strings}}"><Border.Background><ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background></Border>
       <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="5" Padding="8,4" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding Running, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding [RunningBadge], Source={StaticResource Strings}}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
      </Grid>
      <Grid Padding="10,10,8,8" RowSpacing="6" PointerEntered="CardPointerEntered" PointerExited="CardPointerExited" Background="Transparent">
       <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="32"/></Grid.RowDefinitions>
       <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Tag="{Binding}" Click="LaunchClick" Padding="8,4" HorizontalAlignment="Left" ToolTipService.ToolTip="{Binding [Launch], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [Launch], Source={StaticResource Strings}}" Style="{StaticResource AccentButtonStyle}" BorderThickness="0">
         <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="11"/><TextBlock Text="HDR" FontSize="12" FontWeight="SemiBold"/></StackPanel>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource QuietIconButton}" Tag="{Binding}" Click="PinClick" AutomationProperties.Name="{Binding [Pin], Source={StaticResource Strings}}" ToolTipService.ToolTip="{Binding [Pin], Source={StaticResource Strings}}"><FontIcon Glyph="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="14"/></Button>
        <Grid Grid.Column="2"><Button Style="{StaticResource QuietIconButton}" Tag="{Binding}" AutomationProperties.Name="{Binding [GameActions], Source={StaticResource Strings}}" ToolTipService.ToolTip="{Binding [GameActions], Source={StaticResource Strings}}"><FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding [Launch], Source={StaticResource Strings}}" Tag="{Binding}" Click="LaunchClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [Pin], Source={StaticResource Strings}}" Tag="{Binding}" Click="PinClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [Shortcut], Source={StaticResource Strings}}" Tag="{Binding}" Click="ShortcutClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutSeparator/>
<MenuFlyoutItem Text="{Binding [EditGame], Source={StaticResource Strings}}" Tag="{Binding}" Click="EditClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [ChangeCover], Source={StaticResource Strings}}" Tag="{Binding}" Click="CoverClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [FindCover], Source={StaticResource Strings}}" Tag="{Binding}" Click="FindCoverClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [OpenExe], Source={StaticResource Strings}}" Tag="{Binding}" Click="FolderClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [GroupingTitle], Source={StaticResource Strings}}" Tag="{Binding}" Click="GroupingClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutSeparator/>
<MenuFlyoutItem Text="{Binding [Remove], Source={StaticResource Strings}}" Tag="{Binding}" Click="RemoveClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout></Button></Grid>
       </Grid>
      </Grid>
     </StackPanel>
    </Border>
    <Border CornerRadius="12" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" Visibility="{Binding Running, Converter={StaticResource BoolVisibility}}"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="GameRow"><Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Height="64" CornerRadius="6" Background="{ThemeResource PlaceholderSurface}"><Image Source="{Binding CoverImage}" Stretch="{Binding CoverStretch}"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Style="{StaticResource DescriptionText}"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Tag="{Binding}" Click="LaunchClick" ToolTipService.ToolTip="{Binding [Launch], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [Launch], Source={StaticResource Strings}}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12"/><TextBlock Text="HDR"/></StackPanel></Button><Button Style="{StaticResource QuietIconButton}" Tag="{Binding}" AutomationProperties.Name="{Binding [GameActions], Source={StaticResource Strings}}" ToolTipService.ToolTip="{Binding [GameActions], Source={StaticResource Strings}}"><FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding [Launch], Source={StaticResource Strings}}" Tag="{Binding}" Click="LaunchClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [Pin], Source={StaticResource Strings}}" Tag="{Binding}" Click="PinClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [Shortcut], Source={StaticResource Strings}}" Tag="{Binding}" Click="ShortcutClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutSeparator/>
<MenuFlyoutItem Text="{Binding [EditGame], Source={StaticResource Strings}}" Tag="{Binding}" Click="EditClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [ChangeCover], Source={StaticResource Strings}}" Tag="{Binding}" Click="CoverClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [FindCover], Source={StaticResource Strings}}" Tag="{Binding}" Click="FindCoverClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [OpenExe], Source={StaticResource Strings}}" Tag="{Binding}" Click="FolderClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutItem Text="{Binding [GroupingTitle], Source={StaticResource Strings}}" Tag="{Binding}" Click="GroupingClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
<MenuFlyoutSeparator/>
<MenuFlyoutItem Text="{Binding [Remove], Source={StaticResource Strings}}" Tag="{Binding}" Click="RemoveClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout></Button></StackPanel>
  </Grid></DataTemplate>
 </ResourceDictionary></Grid.Resources>
 <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" OpenPaneLength="240" CompactPaneLength="56" ExpandedModeThresholdWidth="1100" CompactModeThresholdWidth="0" PaneDisplayMode="Auto" SelectionChanged="Navigate">
  <NavigationView.PaneHeader><Grid Margin="12,16,12,24" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="Assets/Logo-64.png" Width="40" Height="40"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="Auto HDR Manager" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="1.2.3" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></NavigationView.PaneHeader>
  <NavigationView.MenuItems>
   <NavigationViewItem Content="{Binding [Library], Source={StaticResource Strings}}" Tag="library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="18"/></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem Content="{Binding [Settings], Source={StaticResource Strings}}" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18"/></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem Content="{Binding [Diagnostics], Source={StaticResource Strings}}" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="18"/></NavigationViewItem.Icon></NavigationViewItem>
   <NavigationViewItem Content="{Binding [About], Source={StaticResource Strings}}" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="18"/></NavigationViewItem.Icon></NavigationViewItem>
  </NavigationView.MenuItems>
  <NavigationView.PaneFooter><StackPanel x:Name="NavFooter" Margin="12,12,12,20" Spacing="8"><ComboBox x:Name="LanguagePicker" Header="{Binding [Language], Source={StaticResource Strings}}" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch" MinWidth="0"><ComboBoxItem Content="{Binding [SystemLanguage], Source={StaticResource Strings}}" Tag="System"/><ComboBoxItem Content="Русский" Tag="ru-RU"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></StackPanel></NavigationView.PaneFooter>
  <Grid Padding="24" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="{Binding [Attention], Source={StaticResource Strings}}" Message="{x:Bind ViewModel.Error, Mode=OneWay}"/>
   <Grid x:Name="LibraryPage" Grid.Row="1" RowSpacing="20" SizeChanged="LibrarySizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="LibraryHeader" RowSpacing="20" ColumnSpacing="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="5"><TextBlock Text="{Binding [LibraryTitle], Source={StaticResource Strings}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding [LibrarySubtitle], Source={StaticResource Strings}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <Grid x:Name="LibraryToolbar" Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="10" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Click="AddClick" Style="{StaticResource AccentButtonStyle}" Height="38"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14"/><TextBlock Text="{Binding [AddGame], Source={StaticResource Strings}}"/></StackPanel></Button>
      <Grid Grid.Column="1"><TextBox x:Name="LibrarySearch" PlaceholderText="{Binding [Search], Source={StaticResource Strings}}" TextChanged="SearchChanged" AutomationProperties.Name="{Binding [Search], Source={StaticResource Strings}}" Padding="34,8,10,8" MinWidth="100" Height="38"/><FontIcon Glyph="&#xE721;" FontSize="15" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/></Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"><ToggleButton x:Name="GridViewButton" Tag="Grid" Click="ViewModeClick" Width="38" Height="38" ToolTipService.ToolTip="{Binding [Grid], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [Grid], Source={StaticResource Strings}}"><FontIcon Glyph="&#xE80A;" FontFamily="Segoe Fluent Icons" FontSize="17"/></ToggleButton><ToggleButton x:Name="ListViewButton" Tag="List" Click="ViewModeClick" Width="38" Height="38" ToolTipService.ToolTip="{Binding [List], Source={StaticResource Strings}}" AutomationProperties.Name="{Binding [List], Source={StaticResource Strings}}"><FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="17"/></ToggleButton></StackPanel>
      <Grid Grid.Column="3" VerticalAlignment="Center"><Button Style="{StaticResource QuietIconButton}" AutomationProperties.Name="{Binding [AppMenu], Source={StaticResource Strings}}" ToolTipService.ToolTip="{Binding [AppMenu], Source={StaticResource Strings}}"><FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding [Exit], Source={StaticResource Strings}}" Click="ExitClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" FontFamily="Segoe Fluent Icons" FontSize="16"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout></Button></Grid>
     </Grid>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="18,12">
     <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="26"/>
       <StackPanel Grid.Column="1" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="HDR" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.HdrStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Text="{x:Bind ViewModel.MonitorName, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding [Monitor], Source={StaticResource Strings}}"/></StackPanel>
      </Grid>
      <Grid Grid.Column="1" ColumnSpacing="10" Margin="20,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding [Monitoring], Source={StaticResource Strings}}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="{x:Bind ViewModel.MonitoringStatus, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.PauseLabel, Mode=OneWay}" Click="PauseClick" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" FontWeight="SemiBold"/></StackPanel></Grid>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Visibility="{Binding HasActiveGames, Converter={StaticResource BoolVisibility}}"><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="{x:Bind ViewModel.ActiveGames, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="2">
     <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Spacing="14"><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="40"/><TextBlock Text="{Binding [EmptyTitle], Source={StaticResource Strings}}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{Binding [EmptyBody], Source={StaticResource Strings}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="{Binding [AddGame], Source={StaticResource Strings}}" Click="AddClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"/><Button Content="{Binding [FromRunning], Source={StaticResource Strings}}" Click="ProcessesClick" HorizontalAlignment="Center"/></StackPanel>
     <TextBlock Text="{Binding [NoResults], Source={StaticResource Strings}}" Visibility="{Binding NoResults, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <GridView x:Name="GameGrid" ItemsSource="{x:Bind ViewModel.FilteredGames}" ItemTemplate="{StaticResource GameCard}" SelectionMode="None" Visibility="{Binding ShowGrid, Converter={StaticResource BoolVisibility}}" Padding="0,0,0,4">
      <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
      <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="12"/></Style></GridView.ItemContainerStyle>
     </GridView>
     <ListView x:Name="GameList" ItemsSource="{x:Bind ViewModel.FilteredGames}" ItemTemplate="{StaticResource GameRow}" SelectionMode="None" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20" Width="{Binding ActualWidth, ElementName=SettingsPage}" MaxWidth="860" HorizontalAlignment="Left" Padding="0,0,8,24">
     <StackPanel Spacing="5"><TextBlock Text="{Binding [Settings], Source={StaticResource Strings}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding [SettingsSubtitle], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel>
     <StackPanel Spacing="4"><TextBlock Text="{Binding [General], Source={StaticResource Strings}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [Automatic], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [AutomaticHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.EditSettings.Monitoring, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.Name="{Binding [Automatic], Source={StaticResource Strings}}"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [Startup], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [StartupHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.EditSettings.Startup, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.Name="{Binding [Startup], Source={StaticResource Strings}}"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [StartMinimized], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [StartMinimizedHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.EditSettings.StartMinimized, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.Name="{Binding [StartMinimized], Source={StaticResource Strings}}"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [CloseToTray], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [CloseToTrayHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.EditSettings.CloseToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.Name="{Binding [CloseToTray], Source={StaticResource Strings}}"/></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [Notifications], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [NotificationsHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.EditSettings.Notifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="44" AutomationProperties.Name="{Binding [Notifications], Source={StaticResource Strings}}"/></Grid></Border>
     </StackPanel>
     <StackPanel Spacing="4"><TextBlock Text="{Binding [Appearance], Source={StaticResource Strings}}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [Theme], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [ThemeHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ComboBox Grid.Column="2" VerticalAlignment="Center" x:Name="ThemePicker" SelectionChanged="PreferredThemeChanged" Width="180" AutomationProperties.Name="{Binding [Theme], Source={StaticResource Strings}}"><ComboBoxItem Content="{Binding [System], Source={StaticResource Strings}}" Tag="Default"/><ComboBoxItem Content="{Binding [Light], Source={StaticResource Strings}}" Tag="Light"/><ComboBoxItem Content="{Binding [Dark], Source={StaticResource Strings}}" Tag="Dark"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [Language], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [LanguageHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ComboBox Grid.Column="2" VerticalAlignment="Center" x:Name="SettingsLanguagePicker" SelectionChanged="LanguageChanged" Width="180" AutomationProperties.Name="{Binding [Language], Source={StaticResource Strings}}"><ComboBoxItem Content="{Binding [SystemLanguage], Source={StaticResource Strings}}" Tag="System"/><ComboBoxItem Content="Русский" Tag="ru-RU"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE80A;" FontFamily="Segoe Fluent Icons" FontSize="20"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding [View], Source={StaticResource Strings}}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding [ViewHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/></StackPanel><ComboBox Grid.Column="2" VerticalAlignment="Center" x:Name="ViewPicker" SelectionChanged="PreferredViewChanged" Width="180" AutomationProperties.Name="{Binding [View], Source={StaticResource Strings}}"><ComboBoxItem Content="{Binding [Grid], Source={StaticResource Strings}}" Tag="Grid"/><ComboBoxItem Content="{Binding [List], Source={StaticResource Strings}}" Tag="List"/></ComboBox></Grid></Border>
     </StackPanel>
     <StackPanel Spacing="10"><TextBlock Text="HDR" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource SectionCard}"><StackPanel Spacing="16">
      <ComboBox x:Name="MonitorPicker" Header="{Binding [TargetDisplay], Source={StaticResource Strings}}" ItemsSource="{x:Bind ViewModel.Displays}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="MonitorChanged"/><TextBlock x:Name="MonitorDetails" Style="{StaticResource DescriptionText}"/>
      <NumberBox Header="{Binding [EnableDelay], Source={StaticResource Strings}}" Value="{x:Bind ViewModel.EditSettings.EnableDelaySeconds, Mode=TwoWay}" Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact"/>
      <NumberBox Header="{Binding [RestoreDelay], Source={StaticResource Strings}}" Value="{x:Bind ViewModel.EditSettings.RestoreDelaySeconds, Mode=TwoWay}" Minimum="0" Maximum="60" SpinButtonPlacementMode="Compact"/>
      <TextBlock Text="{Binding [EnableDelayHelp], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/><Button Content="{Binding [CheckHdr], Source={StaticResource Strings}}" Click="CheckHdrClick"/>
     </StackPanel></Border></StackPanel>
     <StackPanel Spacing="10"><TextBlock Text="{Binding [Covers], Source={StaticResource Strings}}" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource SectionCard}"><StackPanel Spacing="16">
      <TextBlock Text="{Binding [CoversInfo], Source={StaticResource Strings}}" TextWrapping="Wrap"/><ToggleSwitch Header="{Binding [OnlineCovers], Source={StaticResource Strings}}" IsOn="{x:Bind ViewModel.EditSettings.OnlineCovers, Mode=TwoWay}" OnContent="{Binding [On], Source={StaticResource Strings}}" OffContent="{Binding [Off], Source={StaticResource Strings}}"/>
      <PasswordBox x:Name="CoverApiKey" Header="{Binding [ApiKey], Source={StaticResource Strings}}" PlaceholderText="{Binding [KeepKey], Source={StaticResource Strings}}"/><TextBlock Text="{Binding [CoverPrivacy], Source={StaticResource Strings}}" Style="{StaticResource DescriptionText}"/>
      <HyperlinkButton Content="{Binding [ApiDocs], Source={StaticResource Strings}}" NavigateUri="https://www.steamgriddb.com/api/v2"/><Button Content="{Binding [RemoveKey], Source={StaticResource Strings}}" Click="RemoveKeyClick"/><Button Content="{Binding [RefreshCovers], Source={StaticResource Strings}}" Click="RefreshCoversClick"/><Button Content="{Binding [ClearIcons], Source={StaticResource Strings}}" Click="ClearCoversClick"/>
     </StackPanel></Border></StackPanel>
     <Button Content="{Binding [Save], Source={StaticResource Strings}}" Click="SaveSettingsClick" Style="{StaticResource AccentButtonStyle}"/><TextBlock x:Name="SavedLabel" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
<ScrollViewer x:Name="DiagnosticsPage" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="{Binding [Diagnostics], Source={StaticResource Strings}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding [DiagnosticsInfo], Source={StaticResource Strings}}" TextWrapping="Wrap"/><Button Content="{Binding [CheckHdr], Source={StaticResource Strings}}" Click="CheckHdrClick" /><Button Content="{Binding [OpenLogs], Source={StaticResource Strings}}" Click="LogsClick" /><Button Content="{Binding [CopyReport], Source={StaticResource Strings}}" Click="DiagnosticsClick" /><TextBlock Text="{Binding [LastError], Source={StaticResource Strings}}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.DiagnosticError, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock x:Name="DiagnosticFeedback" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
<ScrollViewer x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="660" HorizontalAlignment="Left"><Image Source="Assets/Logo-128.png" Width="88" Height="88" HorizontalAlignment="Left"/><TextBlock Text="Auto HDR Manager" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding [AboutVersion], Source={StaticResource Strings}}" Opacity="0.65"/><TextBlock Text="{Binding [AboutTitle], Source={StaticResource Strings}}" FontSize="22" TextWrapping="Wrap"/><TextBlock Text="{Binding [AboutBody], Source={StaticResource Strings}}" TextWrapping="Wrap"/><TextBlock Text="{Binding [AboutOwnership], Source={StaticResource Strings}}" TextWrapping="Wrap"/><TextBlock Text="{Binding [AboutScope], Source={StaticResource Strings}}" TextWrapping="Wrap"/><TextBlock Text="{Binding [AboutPrivacy], Source={StaticResource Strings}}" TextWrapping="Wrap"/><TextBlock Text="{Binding [LicensePending], Source={StaticResource Strings}}" TextWrapping="Wrap"/><Button Content="{Binding [Licenses], Source={StaticResource Strings}}" Click="LicensesClick" /><Button Content="{Binding [DataFolder], Source={StaticResource Strings}}" Click="DataClick" /></StackPanel></ScrollViewer>
</Grid></NavigationView></Grid></Window>



